---
// Carte produit avec lien d'affiliation
// Usage: <ProductCard name="..." image="..." price="..." rating="4.5" href="..." badge="Meilleur choix" />
interface Props {
  name: string;
  image?: string;
  price?: string;
  rating?: string;
  href: string;
  badge?: string;
  pros?: string[];
}
const { name, image, price, rating, href, badge, pros = [] } = Astro.props;
---

<div class="product-card">
  {badge && <span class="product-badge">🏆 {badge}</span>}
  {image && (
    <div class="product-image">
      <img src={image} alt={name} loading="lazy" width="300" height="200" />
    </div>
  )}
  <div class="product-info">
    <h3 class="product-name">{name}</h3>
    {rating && <div class="product-rating">⭐ {rating} / 5</div>}
    {price && <div class="product-price">{price}</div>}
    {pros.length > 0 && (
      <ul class="product-pros">
        {pros.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )}
    <a href={href} target="_blank" rel="noopener sponsored nofollow" class="product-link">
      Voir le prix →
    </a>
  </div>
</div>

<style>
  /* Les styles de base (.product-card, badges…) vivent dans global.css (thème nature) */
  .product-image {
    background: rgba(123, 160, 91, 0.1);
    display: flex;
    justify-content: center;
    padding: 1.2rem;
    border-radius: var(--radius-sm);
  }
  .product-image img {
    width: 100%;
    height: auto;
    max-height: 160px;
    object-fit: contain;
  }
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
</style>
