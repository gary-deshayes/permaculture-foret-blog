---
// Bouton d'affiliation réutilisable
// Usage: <AffiliateButton href="https://amazon.fr/..." text="Voir sur Amazon" />
interface Props {
  href: string;
  text: string;
  note?: string;
}
const { href, text, note = "Prix vérifié — offre partenaire" } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener sponsored nofollow"
  class="affiliate-btn"
>
  <span class="affiliate-btn-text">{text} ↗</span>
  <span class="affiliate-btn-note">{note}</span>
</a>

<style>
  .affiliate-btn {
    display: block;
    max-width: 480px;
    margin: 1.5rem auto;
    padding: 0.9rem 1.5rem;
    background: var(--grad);
    color: #fdfaf0;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 22px rgba(31, 77, 46, 0.32);
    transition: transform 0.15s, box-shadow 0.15s;
    text-align: center;
  }
  .affiliate-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(31, 77, 46, 0.42);
    color: #fff;
  }
  .affiliate-btn-text {
    display: block;
    font-weight: 700;
    font-size: 1.05rem;
  }
  .affiliate-btn-note {
    display: block;
    font-size: 0.75rem;
    opacity: 0.85;
    margin-top: 2px;
  }
</style>
