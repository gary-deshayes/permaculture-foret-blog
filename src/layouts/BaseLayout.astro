---
// Layout de base — SEO complet + navigation nature
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
}
const {
  title,
  description,
  image = "/og-default.jpg",
  type = "website",
} = Astro.props;
const site = new URL(Astro.site ?? "https://permaculture-foret.fr");
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Permaculture Forêt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#faf6ec" />
    <!-- Empêche le navigateur (mode sombre du téléphone) d'auto-darken la page -->
    <meta name="color-scheme" content="light" />

    <!-- Polices : Fraunces (titres organiques) + Inter (texte) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Marqueur JS : sans cette classe, les animations [data-reveal] restent désactivées
      // et tout le contenu est visible par défaut (aucun risque de page vide).
      document.documentElement.classList.add("js");
    </script>

    <!--
      ⚠️ AdSense : décommenter quand approuvé
      <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-VOTRE_ID" crossorigin="anonymous"></script>
    -->
  </head>
  <body>
    <header class="nav">
      <nav class="container nav-inner" aria-label="Navigation principale">
        <a href="/" class="brand" aria-label="Permaculture Forêt — accueil">
          <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="32" height="32" rx="9" fill="#1f4d2e" />
            <path d="M16 25c0-7 2.5-11.5 8.5-14.5-1.5 6.5-4.5 10.5-8.5 14.5Z" fill="#7fa35e" />
            <path d="M16 25c0-7-2.5-11.5-8.5-14.5 1.5 6.5 4.5 10.5 8.5 14.5Z" fill="#7fa35e" />
            <path d="M16 25V10" stroke="#e3a53c" stroke-width="2.2" stroke-linecap="round" />
            <path d="M16 14c-2.5-2.5-5.5-3.5-9-3 2 2.8 5 4.2 9 3Zm0 4c2.5-2 5.5-2.8 9-2-2 2.4-5 3.6-9 2Z" fill="#e3a53c" />
          </svg>
          <span>Permaculture <em style="font-style:italic">Forêt</em></span>
        </a>
        <button class="nav-burger" aria-label="Ouvrir le menu" aria-expanded="false">☰</button>
        <div class="nav-links">
          <a href="/">Accueil</a>
          <a href="/blog/">Articles</a>
          <a href="/outils/calendrier-des-semis/">Calendrier semis</a>
          <a href="/comparatifs/">Comparatifs</a>
          <a href="/a-propos/">À propos</a>
          <a href="/blog/" class="nav-cta">Explorer les guides →</a>
        </div>
      </nav>
    </header>

    <main class="container main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-brand">
              <svg width="26" height="26" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="32" height="32" rx="9" fill="#7fa35e" />
                <path d="M16 25c0-7 2.5-11.5 8.5-14.5-1.5 6.5-4.5 10.5-8.5 14.5Z" fill="#f4efdf" />
                <path d="M16 25c0-7-2.5-11.5-8.5-14.5 1.5 6.5 4.5 10.5 8.5 14.5Z" fill="#f4efdf" />
                <path d="M16 25V10" stroke="#e3a53c" stroke-width="2.2" stroke-linecap="round" />
              </svg>
              Permaculture Forêt
            </div>
            <p class="footer-desc">
              Guides pratiques, comparatifs honnêtes et techniques de forêt-jardin
              pour cultiver un sol vivant, en France et sans se ruiner.
            </p>
          </div>
          <div class="footer-col">
            <h4>Explorer</h4>
            <a href="/blog/">Tous les articles</a>
            <a href="/outils/calendrier-des-semis/">Calendrier des semis</a>
            <a href="/outils/mon-potager/">Mon potager (plan de culture)</a>
            <a href="/comparatifs/">Comparatifs produits</a>
            <a href="/a-propos/">À propos</a>
            <a href="/confidentialite/">Confidentialité</a>
          </div>
          <div class="footer-col">
            <h4>Thématiques</h4>
            <a href="/blog/">Forêt-jardin</a>
            <a href="/blog/">Compost & sol vivant</a>
            <a href="/blog/">Paillage & buttes</a>
            <a href="/blog/">Plantes compagnes</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Permaculture Forêt — Tous droits réservés</span>
          <span>🌱 Cultivé avec soin, sans pesticides</span>
        </div>
        <p class="footer-note">
          Ce site participe au Programme Partenaires d'Amazon EU et d'autres programmes
          d'affiliation. En tant que Partenaire Amazon, nous réalisons un bénéfice sur les
          achats remplissant les conditions requises.
        </p>
      </div>
    </footer>

    <script is:inline>
      // Feuilles flottantes — ambiance forêt (équivalent nature du starfield)
      (function () {
        function init() {
          const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (reduced) return;
          const canvas = document.createElement("canvas");
          canvas.id = "leaves";
          document.body.prepend(canvas);
          const ctx = canvas.getContext("2d");
          let W, H, leaves = [];
          function resize() {
            W = canvas.width = window.innerWidth;
            H = canvas.height = window.innerHeight;
          }
          resize();
          window.addEventListener("resize", resize);
          const COLORS = ["#7fa35e", "#55803f", "#b3bf9a", "#96ab6e", "#6d8f4e"];
          const COUNT = Math.min(26, Math.floor((W * H) / 52000));
          for (let i = 0; i < COUNT; i++) {
            leaves.push({
              x: Math.random() * W,
              y: Math.random() * H,
              size: Math.random() * 11 + 7,
              speed: Math.random() * 0.35 + 0.15,
              sway: Math.random() * Math.PI * 2,
              swaySpeed: Math.random() * 0.02 + 0.008,
              rot: Math.random() * Math.PI * 2,
              rotSpeed: Math.random() * 0.01 + 0.003,
              color: COLORS[Math.floor(Math.random() * COLORS.length)],
              opacity: Math.random() * 0.34 + 0.16,
            });
          }
          let last = 0;
          function frame(t) {
            requestAnimationFrame(frame);
            const dt = Math.min((t - last) / 1000 || 0.016, 0.05);
            last = t;
            ctx.clearRect(0, 0, W, H);
            for (const l of leaves) {
              l.y += l.speed * dt * 60;
              l.sway += l.swaySpeed * 60 * dt;
              l.rot += l.rotSpeed * 60 * dt;
              l.x += Math.sin(l.sway) * 0.5;
              if (l.y > H + 40) { l.y = -40; l.x = Math.random() * W; }
              if (l.x > W + 40) l.x = -40;
              if (l.x < -40) l.x = W + 40;
              ctx.save();
              ctx.translate(l.x, l.y);
              ctx.rotate(l.rot);
              ctx.globalAlpha = l.opacity;
              // Feuille : ellipse + nervure
              ctx.fillStyle = l.color;
              ctx.beginPath();
              ctx.ellipse(0, 0, l.size * 0.5, l.size * 0.28, 0, 0, Math.PI * 2);
              ctx.fill();
              ctx.strokeStyle = "rgba(31, 45, 26, 0.35)";
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(-l.size * 0.5, 0);
              ctx.lineTo(l.size * 0.5, 0);
              ctx.stroke();
              ctx.restore();
            }
          }
          requestAnimationFrame(frame);
        }
        document.addEventListener("DOMContentLoaded", init);
      })();

      // Reveal on scroll — seuil 0.01 (compatible éléments très hauts), éléments déjà
      // à l'écran révélés immédiatement, + filet de sécurité 2 s : jamais de contenu invisible.
      (function () {
        const els = document.querySelectorAll("[data-reveal]");
        if (!els.length) return;
        if (!("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("visible"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.01, rootMargin: "0px 0px -20px 0px" }
        );
        els.forEach((el) => {
          io.observe(el);
          // Déjà dans le viewport au chargement → visible tout de suite
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) el.classList.add("visible");
        });
        setTimeout(() => els.forEach((el) => el.classList.add("visible")), 2000);
      })();

      // Burger menu mobile
      (function () {
        const burger = document.querySelector(".nav-burger");
        const links = document.querySelector(".nav-links");
        if (!burger || !links) return;
        burger.addEventListener("click", () => {
          const open = links.classList.toggle("open");
          burger.setAttribute("aria-expanded", String(open));
        });
        links.querySelectorAll("a").forEach((a) =>
          a.addEventListener("click", () => {
            links.classList.remove("open");
            burger.setAttribute("aria-expanded", "false");
          })
        );
      })();
    </script>
  </body>
</html>
