---
// Layout d'article — SEO Article + encarts pub + affiliation
import BaseLayout from "./BaseLayout.astro";
import AdSlot from "../components/AdSlot.astro";
import AffiliateDisclaimer from "../components/AffiliateDisclaimer.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  image?: string;
}
const { title, description, pubDate, updatedDate, tags = [], image } = Astro.props;
const site = new URL(Astro.site ?? "https://permaculture-foret.fr");
const canonical = new URL(Astro.url.pathname, site);

// JSON-LD structuré pour Google (rich results)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  image: image ? new URL(image, site).toString() : undefined,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { "@type": "Person", name: "Permaculture Forêt" },
  publisher: {
    "@type": "Organization",
    name: "Permaculture Forêt",
    logo: { "@type": "ImageObject", url: new URL("/favicon.svg", site).toString() },
  },
  mainEntityOfPage: canonical.toString(),
};
---

<BaseLayout title={title} description={description} image={image} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="post" style="padding-top: calc(var(--nav-h) + 44px)">
    <header class="post-header">
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString("fr-FR", { dateStyle: "long" })}
        </time>
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => (
              <span>#{t}</span>
            ))}
          </div>
        )}
      </div>
      <h1>{title}</h1>
      <p class="post-desc">{description}</p>
    </header>

    {image && (
      <figure class="post-hero">
        <img src={image} alt={title} width="1280" height="720" loading="eager" fetchpriority="high" />
      </figure>
    )}

    <!-- 📢 Encart pub : haut d'article -->
    <AdSlot format="horizontal" />

    <div class="post-content">
      <slot />
    </div>

    <!-- 📢 Encart pub : bas d'article -->
    <AdSlot format="horizontal" />

    <AffiliateDisclaimer />

    <div class="post-nav">
      <a href="/blog/">← Tous les articles</a>
      <a href="/comparatifs/">Nos comparatifs produits →</a>
    </div>
  </article>
</BaseLayout>
