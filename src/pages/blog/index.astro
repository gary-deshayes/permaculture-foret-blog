---
// Liste des articles
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Tous les articles — Permaculture Forêt"
  description="Tous nos guides, comparatifs et conseils en permaculture, agroforesterie et jardinage naturel."
>
  <h1>📚 Tous les articles</h1>
  <div class="posts-list">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}/`} class="post-item">
        {post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="post-item-img"
            width="1280"
            height="720"
            loading="lazy"
          />
        )}
        <div class="post-item-body">
          <div class="post-item-date">
            {post.data.pubDate.toLocaleDateString("fr-FR", { dateStyle: "long" })}
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          {post.data.tags && (
            <div class="post-item-tags">
              {post.data.tags.map((t) => (
                <span class="tag">#{t}</span>
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  .post-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .post-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }
  .post-item-img {
    flex: 0 0 200px;
    width: 200px;
    height: 112px;
    object-fit: cover;
    border-radius: calc(var(--radius) - 4px);
  }
  .post-item-body {
    flex: 1;
    min-width: 0;
  }
  @media (max-width: 640px) {
    .post-item {
      flex-direction: column;
    }
    .post-item-img {
      flex: none;
      width: 100%;
      height: auto;
      max-height: 180px;
    }
  }
  .post-item-date {
    font-size: 0.78rem;
    color: var(--primary);
    font-weight: 700;
    text-transform: uppercase;
  }
  .post-item h2 {
    margin: 0.4rem 0;
    font-size: 1.3rem;
  }
  .post-item p {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0 0 0.75rem;
  }
  .post-item-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    background: #d1fae5;
    color: #047857;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
  }
</style>
