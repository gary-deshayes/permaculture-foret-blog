---
// Liste des articles — grille nature
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Tous les articles — Permaculture Forêt"
  description="Tous nos guides, comparatifs et conseils en permaculture, agroforesterie et jardinage naturel : buttes, compost, paillage, forêt-jardin, plantes compagnes."
>
  <section class="page-hero">
    <div class="kicker" data-reveal>Le carnet de bord</div>
    <h1 data-reveal data-delay="1">
      Tous les <span class="grad-text italic-accent">articles</span>
    </h1>
    <div class="blog-list-head" data-reveal data-delay="2">
      <p>
        Guides pas à pas, techniques de saison et comparatifs honnêtes pour
        cultiver un jardin vivant.
      </p>
      <span class="blog-count">{posts.length} guides publiés</span>
    </div>
  </section>

  <section class="page-body">
    <div class="posts-grid">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="post-card">
          {post.data.heroImage && (
            <div class="post-card-img">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                width="640"
                height="360"
                loading="lazy"
              />
            </div>
          )}
          <div class="post-card-body">
            <div class="post-card-date">
              {post.data.pubDate.toLocaleDateString("fr-FR", { dateStyle: "long" })}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-card-meta">
              <div class="post-card-tags">
                {(post.data.tags ?? []).map((t) => (
                  <span class="tag">#{t}</span>
                ))}
              </div>
              <span class="post-card-arrow">Lire →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
