---
// Page d'accueil — hero forêt + produits vedettes + derniers guides
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const SITE_TITLE = "Permaculture Forêt";
const SITE_DESC =
  "Guides pratiques et comparatifs honnêtes pour cultiver autrement : permaculture, forêt-jardin, sol vivant. Recommandations testées, prix vérifiés.";
---

<BaseLayout title={`${SITE_TITLE} — Guides & comparatifs permaculture`} description={SITE_DESC}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="hero-badge" data-reveal>
          <span class="dot"></span>
          Permaculture · Agroforesterie · Sol vivant
        </div>
        <h1 data-reveal data-delay="1">
          Cultivez un <span class="grad-text italic-accent">jardin forêt</span> qui se
          nourrit tout seul
        </h1>
        <p class="hero-intro" data-reveal data-delay="2">
          Des guides pas à pas, des comparatifs honnêtes et des techniques éprouvées
          pour créer un écosystème comestible — même sur un petit terrain, sans
          labour et sans produits chimiques.
        </p>
        <div class="hero-cta" data-reveal data-delay="3">
          <a href="/blog/" class="btn btn-primary">Explorer les guides →</a>
          <a href="/comparatifs/" class="btn btn-ghost">Voir les comparatifs</a>
        </div>
        <div class="hero-stats" data-reveal data-delay="4">
          <div class="hero-stat"><b>{posts.length}+</b><span>guides pratiques</span></div>
          <div class="hero-stat"><b>100 %</b><span>indépendant</span></div>
          <div class="hero-stat"><b>0 €</b><span>pour les lecteurs</span></div>
        </div>
      </div>

      <div data-reveal data-delay="2">
        <div class="rings-wrap" aria-hidden="true">
          <div class="rings-glow"></div>
          <div class="ring ring-1"></div>
          <div class="ring ring-2"></div>
          <div class="ring ring-3"></div>
          <div class="ring ring-4"></div>
          <div class="rings-core">🌱</div>
          <div class="orbit-leaf l1">🍃</div>
          <div class="orbit-leaf l2">🌿</div>
          <div class="orbit-leaf l3">🍂</div>
          <div class="orbit-leaf l4">🌾</div>
          <div class="rings-caption">La forêt pousse lentement… mais toute seule</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ MARQUEE ============ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {[0, 1].map((dup) => (
        <div class="marquee-item" key={dup}>
          <span>Permaculture</span><span>Forêt-jardin</span><span>Compost</span><span>Paillage</span><span>Buttes</span><span>Sol vivant</span><span>Plantes compagnes</span><span>Agroforesterie</span><span>Autonomie</span><span>Semis</span>
        </div>
      ))}
    </div>
  </div>

  <!-- ============ PRODUITS VEDETTES ============ -->
  <section class="container">
    <div class="kicker" data-reveal>Nos coups de cœur</div>
    <h2 class="section-title" data-reveal data-delay="1">
      Recommandations <span class="grad-text italic-accent">du moment</span>
    </h2>
    <p class="section-sub" data-reveal data-delay="2">
      Testés, utilisés, approuvés. Des outils qui respectent le sol et durent dans le
      temps — sélectionnés sans compromis sur la qualité.
    </p>
    <div class="products-grid" data-reveal data-delay="2">
      <ProductCard
        name="Grelinette professionnelle — aération du sol sans effort"
        price="~65 €"
        rating="4.7"
        href="https://www.amazon.fr/s?k=grelinette"
        badge="Meilleur choix"
        pros={["Aère sans retourner", "Préserve la vie du sol", "Dos préservé"]}
      />
      <ProductCard
        name="Butteuse / cultivateur 3 dents"
        price="~35 €"
        rating="4.4"
        href="https://www.amazon.fr/s?k=cultivateur+3+dents+jardin"
        pros={["Désherbage rapide", "Léger et maniable", "Idéal carrés potagers"]}
      />
      <ProductCard
        name="Paillage biodégradable en chanvre (rouleau)"
        price="~25 €"
        rating="4.2"
        href="https://www.amazon.fr/s?k=paillage+chanvre+jardin"
        pros={["Limite l'arrosage", "Nourrit le sol", "100 % naturel"]}
      />
    </div>
    <p class="affiliate-note" data-reveal>
      * Liens d'affiliation — prix susceptibles de varier. Voir notre{" "}
      <a href="/comparatifs/">page comparatifs</a>.
    </p>
  </section>

  <!-- ============ DERNIERS GUIDES ============ -->
  <section class="container">
    <div class="kicker" data-reveal>Le carnet de bord</div>
    <h2 class="section-title" data-reveal data-delay="1">
      Derniers <span class="grad-text italic-accent">guides</span>
    </h2>
    <p class="section-sub" data-reveal data-delay="2">
      Un nouveau guide pratique chaque semaine : techniques, saisons, erreurs à
      éviter. Écrits par un jardinier, pas par un chatbot.
    </p>
    <div class="posts-grid" data-reveal data-delay="2">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="post-card">
          {post.data.heroImage && (
            <div class="post-card-img">
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                width="640"
                height="360"
                loading="lazy"
              />
            </div>
          )}
          <div class="post-card-body">
            <div class="post-card-date">
              {post.data.pubDate.toLocaleDateString("fr-FR", { dateStyle: "long" })}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="post-card-meta">
              <div class="post-card-tags">
                {(post.data.tags ?? []).slice(0, 2).map((t) => (
                  <span class="tag">#{t}</span>
                ))}
              </div>
              <span class="post-card-arrow">Lire →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
    <p style="text-align:center;margin-top:36px" data-reveal>
      <a href="/blog/" class="btn btn-ghost">Voir tous les articles →</a>
    </p>
  </section>

  <!-- ============ CTA BANDEAU ============ -->
  <section class="container">
    <div class="cta-band" data-reveal>
      <h2>Prêt à lancer votre première butte ?</h2>
      <p>
        Commencez par le guide complet pour débuter en permaculture potagère :
        10 erreurs à éviter, le bon emplacement, et les premiers gestes.
      </p>
      <a href="/blog/guide-complet-debuter-permaculture-potagere/" class="btn btn-cream">
        Lire le guide débutant →
      </a>
    </div>
  </section>
</BaseLayout>
