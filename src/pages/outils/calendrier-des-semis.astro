---
// Calendrier des semis interactif — par date de gelées + géolocalisation
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ZONES, CITIES, MONTHS, VEGS, weekToDate } from "../../data/semis.mjs";

const data = JSON.stringify({ zones: ZONES, cities: CITIES, months: MONTHS, vegs: VEGS });

const faq = [
  {
    q: "Que semer en ce moment ?",
    a: "Le calendrier s'ouvre sur le mois en cours et se règle sur les dernières gelées moyennes de votre région (par défaut celles du Bassin parisien). Cliquez sur « Me localiser » ou choisissez votre ville : chaque légume se sème alors en fonction de votre date de gelées.",
  },
  {
    q: "Pourquoi la date des dernières gelées change tout ?",
    a: "Un même légume se sème plusieurs semaines plus tôt à Nice (gelées fin février) que dans les Vosges (fin avril). Le calendrier calcule chaque légume en semaines relatives aux gelées : la tomate se sème sous abri 9 à 5 semaines avant, la mâche 18 semaines après. Changez la date, tout se décale.",
  },
  {
    q: "Comment la date de gelées est-elle déterminée ?",
    a: "Chaque ville du sélecteur a une date moyenne approximative (dérivée des normales climatiques). La géolocalisation vous rattache à la ville la plus proche. Vous pouvez ensuite ajuster finement avec le curseur — votre jardin a son propre microclimat : expositions, altitude, sol.",
  },
  {
    q: "Ces dates sont-elles fiables ?",
    a: "Ce sont des repères moyens, pas des certitudes. Observez la météo locale : une année sans gelées tardives permet de semer plus tôt, un printemps froid impose d'attendre. Le paillage et les voiles d'hivernage restent vos meilleurs alliés.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Calendrier des semis par date de gelées : que semer selon votre région (2026)"
  description="Calendrier des semis interactif et gratuit : 30 légumes calculés en fonction des dernières gelées moyennes de votre ville. Géolocalisation, 80 villes, ajustement fin."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/json" id="semis-data" set:html={data} />

  <!-- ============ HERO ============ -->
  <section class="page-hero semis-hero">
    <div class="kicker" data-reveal>Outil de jardin</div>
    <h1 data-reveal data-delay="1">
      Calendrier des <span class="grad-text italic-accent">semis</span> par
      <span class="grad-text italic-accent">gelées</span>
    </h1>
    <p data-reveal data-delay="2">
      30 légumes calculés sur la <strong>date des dernières gelées</strong> de
      votre ville. Localisez-vous, choisissez votre climat ou réglez le curseur :
      chaque date de semis se décale automatiquement.
    </p>
  </section>

  <!-- ============ OUTIL ============ -->
  <section class="semis-section">
    <div class="tool-panel" data-reveal>
      <!-- Localisation -->
      <div class="geo-bar">
        <button id="geo-btn" class="btn btn-primary" type="button">📍 Me localiser</button>
        <select id="city-select" class="city-select" aria-label="Choisir votre ville">
          <option value="">🏙️ Choisir une ville…</option>
          {CITIES.map((c) => (
            <option value={c[3]} data-city={c[0]} data-frost={c[4]}>
              {c[0]} — {ZONES[c[3]].label}
            </option>
          ))}
        </select>
      </div>
      <p id="geo-status" class="geo-status">Choisissez un climat ou une ville…</p>

      <!-- Climats (presets de gelées) -->
      <div class="zone-pills" role="tablist" aria-label="Zone climatique">
        {Object.entries(ZONES).map(([key, z]) => (
          <button class="zone-pill" data-zone={key} data-frost={z.frost} type="button" role="tab">
            <span class="zone-emoji">{z.emoji}</span>
            <span>{z.label}</span>
          </button>
        ))}
      </div>
      <p id="zone-detail" class="zone-detail"></p>

      <!-- Curseur : dernières gelées -->
      <div class="frost-box">
        <div class="frost-head">
          <span class="frost-label">❄️ Dernières gelées moyennes</span>
          <span id="frost-date" class="frost-date chip">…</span>
        </div>
        <input
          id="frost-slider"
          class="frost-slider"
          type="range"
          min="6"
          max="24"
          step="1"
          value="15"
          aria-label="Semaine des dernières gelées"
        />
        <div class="frost-scale">
          <span>Fin janvier</span><span>Fin février</span><span>Fin mars</span><span>Fin avril</span><span>Fin mai</span><span>Fin juin</span>
        </div>
        <p class="frost-hint">
          🌡️ C'est la date moyenne après laquelle le gel ne revient plus. Votre
          jardin a son microclimat : ajustez ce curseur à votre expérience.
        </p>
      </div>

      <!-- Mois -->
      <div class="month-tabs" role="tablist" aria-label="Mois">
        {MONTHS.map((m, i) => (
          <button class="month-tab" data-month={i + 1} type="button" role="tab">
            {m}
          </button>
        ))}
      </div>

      <p class="month-heading">
        🌱 Que semer en <strong id="month-label">…</strong> · gelées ~
        <strong id="frost-label">…</strong>
      </p>
      <div class="legend">
        <span class="lg lg-abri">Semis sous abri</span>
        <span class="lg lg-terre">Semis pleine terre</span>
        <span class="lg lg-recolte">Récolte</span>
      </div>

      <div id="semis-grid" class="semis-grid"></div>
      <p class="disclaimer">
        * Dates calculées en semaines relatives aux dernières gelées moyennes —
        tenez compte de la météo réelle. Liens graines : affiliation Amazon.
      </p>
    </div>
  </section>

  <!-- ============ LIEN MON POTAGER ============ -->
  <section class="semis-section">
    <div class="cross-banner" data-reveal>
      <span>🥕</span>
      <p>
        Construisez votre plan de culture personnel ?
        <a href="/outils/mon-potager/">Créer « Mon potager » →</a>
      </p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq">
    <div class="kicker" data-reveal>Questions fréquentes</div>
    <h2 class="section-title" data-reveal data-delay="1">FAQ semis & gelées</h2>
    <div class="faq-list" data-reveal data-delay="2">
      {faq.map((f) => (
        <details class="faq-item card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      const data = JSON.parse(document.getElementById("semis-data").textContent);
      const { zones, cities, months, vegs } = data;
      const state = { frost: 15, month: new Date().getMonth() + 1 };

      const zoneDetail = document.getElementById("zone-detail");
      const monthLabel = document.getElementById("month-label");
      const frostLabel = document.getElementById("frost-label");
      const frostDate = document.getElementById("frost-date");
      const frostSlider = document.getElementById("frost-slider");
      const grid = document.getElementById("semis-grid");
      const geoStatus = document.getElementById("geo-status");
      const citySelect = document.getElementById("city-select");

      // Semaine (1-52) → date lisible
      function weekToDate(w) {
        const d = new Date(2026, 0, w * 7 - 3);
        return d.toLocaleDateString("fr-FR", { day: "numeric", month: "long" });
      }
      // Semaine → mois (1-12)
      function monthOf(w) {
        return Math.min(12, Math.max(1, Math.floor((w - 1) / 4.34) + 1));
      }
      // Fenêtres en semaines relatives → ensemble de mois actifs
      function windowsToMonths(windows, frost) {
        const set = new Set();
        for (const [s, e] of windows) {
          for (let w = s; w <= e; w++) set.add(monthOf(frost + w));
        }
        return [...set];
      }

      // --- Réglage de la date de gelées ---
      function setFrost(w, via = "manuel") {
        state.frost = w;
        frostSlider.value = w;
        const date = weekToDate(w);
        frostDate.textContent = `~ ${date}`;
        frostLabel.textContent = date;

        // Climat correspondant (preset) ?
        let matched = null;
        for (const [key, z] of Object.entries(zones)) {
          if (z.frost === w) matched = key;
        }
        document.querySelectorAll(".zone-pill").forEach((el) =>
          el.classList.toggle("active", el.dataset.zone === matched)
        );
        if (matched) {
          const z = zones[matched];
          zoneDetail.textContent = `${z.emoji} ${z.desc}`;
        } else {
          zoneDetail.textContent = `Calendrier réglé sur des gelées vers ${date} — ajustez le curseur selon votre jardin.`;
        }
        if (via === "manuel") geoStatus.textContent = `Gelées réglées vers ${date}`;
        render();
      }
      frostSlider.addEventListener("input", () => setFrost(parseInt(frostSlider.value, 10)));

      // --- Presets climat ---
      document.querySelectorAll(".zone-pill").forEach((btn) =>
        btn.addEventListener("click", () => {
          setFrost(parseInt(btn.dataset.frost, 10), "preset");
          geoStatus.textContent = `Climat ${zones[btn.dataset.zone].label} — gelées ~ ${weekToDate(parseInt(btn.dataset.frost, 10))}`;
        })
      );

      // --- Ville ---
      citySelect.addEventListener("change", () => {
        if (citySelect.value) {
          const opt = citySelect.options[citySelect.selectedIndex];
          setFrost(parseInt(opt.dataset.frost, 10), "ville");
          geoStatus.textContent = `📍 ${opt.dataset.city} — gelées ~ ${weekToDate(parseInt(opt.dataset.frost, 10))} (climat ${zones[citySelect.value].label})`;
        }
      });

      // --- Mois ---
      document.querySelectorAll(".month-tab").forEach((btn) =>
        btn.addEventListener("click", () => setMonth(parseInt(btn.dataset.month, 10)))
      );
      function setMonth(m) {
        state.month = m;
        document.querySelectorAll(".month-tab").forEach((el) =>
          el.classList.toggle("active", parseInt(el.dataset.month, 10) === m)
        );
        monthLabel.textContent = months[m - 1];
        render();
      }

      // --- Géolocalisation ---
      document.getElementById("geo-btn").addEventListener("click", () => {
        if (!navigator.geolocation) {
          geoStatus.textContent = "Géolocalisation non supportée — choisissez votre ville.";
          return;
        }
        geoStatus.textContent = "📍 Localisation en cours…";
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude: lat, longitude: lon } = pos.coords;
            let best = null, bestD = Infinity;
            for (const [name, clat, clon, z, f] of cities) {
              const d = Math.hypot(clat - lat, clon - lon);
              if (d < bestD) { bestD = d; best = [name, z, f]; }
            }
            setFrost(best[2], "geo");
            geoStatus.textContent = `📍 Détecté : ${best[0]} — gelées ~ ${weekToDate(best[2])} (climat ${zones[best[1]].label}, approx.)`;
          },
          () => {
            geoStatus.textContent = "Géolocalisation refusée ou indisponible — choisissez votre ville.";
          },
          { timeout: 6000, maximumAge: 600000 }
        );
      });

      // --- Rendu ---
      function render() {
        const m = state.month;
        const frost = state.frost;
        const cards = [];

        for (const v of vegs) {
          const abri = windowsToMonths(v.abri || [], frost);
          const terre = windowsToMonths(v.terre || [], frost);
          const recolte = windowsToMonths(v.recolte || [], frost);
          const inAbri = abri.includes(m);
          const inTerre = terre.includes(m);
          const inRecolte = recolte.includes(m);
          if (!inAbri && !inTerre && !inRecolte) continue;

          const aff = "https://www.amazon.fr/s?k=" + encodeURIComponent("graines de " + v.n.toLowerCase());
          const badges = [
            inAbri ? '<span class="b b-abri">Sous abri</span>' : "",
            inTerre ? '<span class="b b-terre">Pleine terre</span>' : "",
            inRecolte ? '<span class="b b-recolte">Récolte</span>' : "",
          ].join("");
          cards.push(`
            <div class="semis-card card">
              <div class="semis-head">
                <h3>${v.n}</h3>
                <span class="family">${v.f}</span>
              </div>
              <div class="badges">${badges}</div>
              <div class="meta">
                <span>📏 ${v.d} cm</span><span>↔️ ${v.e} cm</span><span>${v.su}</span>
              </div>
              <p class="companions">🌿 ${v.c}</p>
              <p class="tip">${v.tip}</p>
              <div class="semis-links">
                <a href="${aff}" target="_blank" rel="noopener sponsored nofollow" class="aff">Graines ↗</a>
                ${v.link ? `<a href="${v.link}" class="guide">Guide →</a>` : ""}
              </div>
            </div>
          `);
        }

        grid.innerHTML = cards.length
          ? cards.join("")
          : `<p class="empty">Rien à semer ni récolter en ${months[m - 1]} — profitez-en pour préparer le sol 🌱</p>`;
      }

      // --- Init ---
      setMonth(state.month);
      setFrost(15, "manuel");
    })();
  </script>
</BaseLayout>

<style>
  .semis-hero { padding-bottom: 8px; }
  .semis-hero p { max-width: 580px; }

  /* ============ Panneau outil ============ */
  .semis-section { padding-top: 24px; }
  .tool-panel {
    background: var(--panel-strong);
    border: 1px solid var(--border);
    border-radius: 26px;
    padding: 30px;
    box-shadow: var(--shadow);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .geo-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .geo-status { font-size: 13.5px; color: var(--muted); font-weight: 500; margin: 10px 0 16px; }
  .city-select {
    font-family: var(--font-body);
    font-size: 14px;
    padding: 11px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--paper);
    color: var(--text);
    max-width: 340px;
    cursor: pointer;
    flex: 1;
    min-width: 200px;
  }

  /* Zones : pills défilantes */
  .zone-pills {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 2px 2px 10px;
    scrollbar-width: thin;
    margin-bottom: 4px;
  }
  .zone-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--paper);
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s;
  }
  .zone-pill:hover { border-color: var(--moss); color: var(--forest); }
  .zone-pill.active {
    background: var(--grad);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 6px 16px rgba(31, 77, 46, 0.3);
  }
  .zone-emoji { font-size: 16px; }
  .zone-detail { font-size: 13.5px; color: var(--muted); line-height: 1.55; margin: 0 0 20px; }

  /* Curseur gelées */
  .frost-box {
    background: rgba(127, 163, 94, 0.09);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 18px 20px 14px;
    margin-bottom: 22px;
  }
  .frost-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .frost-label { font-family: var(--font-display); font-size: 17px; font-weight: 600; color: var(--forest-2); }
  .frost-date {
    font-size: 13.5px;
    font-weight: 700;
    background: var(--grad);
    color: #fff;
    padding: 5px 16px;
    border-radius: 999px;
    box-shadow: 0 6px 14px rgba(31, 77, 46, 0.28);
  }
  .frost-slider {
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(90deg, #b3bf9a, #7fa35e 40%, #55803f 70%, #1e4a2b);
    outline: none;
    cursor: pointer;
  }
  .frost-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--paper);
    border: 4px solid var(--forest);
    box-shadow: 0 4px 12px rgba(31, 60, 28, 0.35);
    cursor: grab;
  }
  .frost-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--paper);
    border: 4px solid var(--forest);
    box-shadow: 0 4px 12px rgba(31, 60, 28, 0.35);
    cursor: grab;
  }
  .frost-scale {
    display: flex;
    justify-content: space-between;
    font-size: 10.5px;
    color: var(--muted);
    margin-top: 8px;
  }
  .frost-hint { font-size: 12.5px; color: var(--muted); margin: 10px 0 0; }

  /* Mois */
  .month-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 10px;
    margin-bottom: 14px;
    scrollbar-width: thin;
  }
  .month-tab {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--paper);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
  }
  .month-tab:hover { color: var(--forest); border-color: var(--moss); }
  .month-tab.active {
    background: var(--grad);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 6px 16px rgba(31, 77, 46, 0.3);
  }

  .month-heading { font-size: 16.5px; margin-bottom: 12px; color: var(--muted); }
  .month-heading strong { color: var(--forest-2); }

  .legend { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
  .lg { font-size: 12px; font-weight: 600; padding: 5px 13px; border-radius: 999px; }
  .lg-abri { background: rgba(217, 154, 61, 0.16); color: #9a6a1e; border: 1px solid rgba(217, 154, 61, 0.35); }
  .lg-terre { background: rgba(85, 128, 63, 0.14); color: var(--moss); border: 1px solid rgba(85, 128, 63, 0.35); }
  .lg-recolte { background: rgba(127, 163, 94, 0.14); color: #4c6b34; border: 1px solid rgba(127, 163, 94, 0.35); }

  /* Grille de légumes */
  .semis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 16px;
  }
  .semis-card {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 18px 18px 16px;
  }
  .semis-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .semis-head h3 { font-size: 18px; }
  .family {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    background: rgba(47, 71, 43, 0.07);
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badges { display: flex; gap: 7px; flex-wrap: wrap; }
  .b { font-size: 12px; font-weight: 700; padding: 3px 11px; border-radius: 999px; }
  .b-abri { background: rgba(217, 154, 61, 0.16); color: #9a6a1e; }
  .b-terre { background: rgba(85, 128, 63, 0.14); color: var(--moss); }
  .b-recolte { background: rgba(127, 163, 94, 0.16); color: #4c6b34; }
  .meta { display: flex; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
  .companions { font-size: 13.5px; color: var(--text); margin: 0; }
  .tip { font-size: 13.5px; color: var(--muted); font-style: italic; margin: 0; }
  .semis-links { margin-top: auto; display: flex; gap: 10px; align-items: center; padding-top: 6px; }
  .aff {
    font-size: 13.5px;
    font-weight: 700;
    color: #fff;
    background: var(--grad);
    padding: 8px 18px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .aff:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(31, 77, 46, 0.35); color: #fff; }
  .guide { font-size: 13.5px; font-weight: 600; color: var(--forest); }
  .empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--muted);
    background: var(--panel);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    padding: 30px;
  }
  .disclaimer { font-size: 12px; color: var(--muted); margin-top: 16px; }

  /* Bannière lien croisé */
  .cross-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px;
    border-radius: 18px;
    background: rgba(127, 163, 94, 0.1);
    border: 1px solid var(--border);
    font-size: 15px;
    color: var(--text);
  }
  .cross-banner a { font-weight: 700; color: var(--forest); }
  .semis-section .cross-banner { margin-top: 0; }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 760px; }
  .faq-item { padding: 16px 20px; }
  .faq-item summary {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--forest-2);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .faq-item summary::after { content: "＋"; color: var(--moss); font-size: 18px; transition: transform 0.2s; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { margin: 12px 0 0; color: var(--muted); font-size: 14.5px; }

  /* ============ Mobile ============ */
  @media (max-width: 640px) {
    .semis-section { padding-top: 16px; }
    .tool-panel { padding: 20px 14px; border-radius: 20px; }
    .geo-bar { flex-direction: column; align-items: stretch; }
    .geo-bar .btn { width: 100%; justify-content: center; }
    .city-select { min-width: 0; width: 100%; max-width: none; }
