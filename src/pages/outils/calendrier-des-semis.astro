---
// Calendrier des semis interactif — par climat + géolocalisation
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ZONES, CITIES, MONTHS, withOffsets } from "../../data/semis.mjs";

const vegs = withOffsets();
const data = JSON.stringify({ zones: ZONES, cities: CITIES, months: MONTHS, vegs });

const faq = [
  {
    q: "Que semer en ce moment ?",
    a: "Le calendrier s'ouvre automatiquement sur le mois en cours, adapté à votre climat. Cliquez sur « Me localiser » ou choisissez votre zone (océanique, bassin parisien, continental, méditerranéen ou montagnard) pour voir les légumes à semer sous abri, en pleine terre et à récolter ce mois-ci.",
  },
  {
    q: "Pourquoi les dates changent selon le climat ?",
    a: "Un même légume se sème 1 à 2 mois plus tôt sur la côte méditerranéenne que dans les Vosges ou en altitude. Le calendrier applique un décalage de saison à chaque climat : les méditerranéens démarrent plus tôt, les montagnards attendent la fin des gelées, les océaniques suivent un rythme doux et humide.",
  },
  {
    q: "Comment la géolocalisation fonctionne-t-elle ?",
    a: "Avec votre accord, le site détecte votre position et la compare à une base de villes françaises pour déterminer votre climat approximatif. Aucune donnée n'est envoyée à un serveur : tout se calcule dans votre navigateur. Vous pouvez aussi choisir votre ville ou votre zone manuellement.",
  },
  {
    q: "Ces dates sont-elles fiables ?",
    a: "Ce sont des repères moyens issus des pratiques de jardinage françaises. Chaque jardin a son microclimat : expositions, altitude, sol. Observez la météo locale et les gelées tardives avant de vous lancer, surtout en climat continental et montagnard.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Calendrier des semis : que semer par mois, climat et région (2026)"
  description="Calendrier des semis interactif et gratuit : 30 légumes, 5 climats français (océanique, bassin parisien, continental, méditerranéen, montagnard) et géolocalisation automatique."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/json" id="semis-data" set:html={data} />

  <!-- ============ HERO ============ -->
  <section class="page-hero semis-hero">
    <div class="kicker" data-reveal>Outil de jardin</div>
    <h1 data-reveal data-delay="1">
      Calendrier des <span class="grad-text italic-accent">semis</span>
    </h1>
    <p data-reveal data-delay="2">
      30 légumes adaptés à <strong>votre climat</strong> : localisez-vous ou
      choisissez votre zone — les dates se décalent automatiquement.
    </p>
  </section>

  <!-- ============ OUTIL ============ -->
  <section class="semis-section">
    <div class="tool-panel" data-reveal>
      <!-- Localisation -->
      <div class="geo-bar">
        <button id="geo-btn" class="btn btn-primary" type="button">📍 Me localiser</button>
        <select id="city-select" class="city-select" aria-label="Choisir votre ville">
          <option value="">🏙️ Choisir une ville…</option>
          {CITIES.map((c) => (
            <option value={c[3]} data-city={c[0]}>
              {c[0]} — {ZONES[c[3]].label}
            </option>
          ))}
        </select>
      </div>
      <p id="geo-status" class="geo-status">Choisissez votre zone ci-dessous…</p>

      <!-- Zones en pills -->
      <div class="zone-pills" role="tablist" aria-label="Zone climatique">
        {Object.entries(ZONES).map(([key, z]) => (
          <button class="zone-pill" data-zone={key} type="button" role="tab">
            <span class="zone-emoji">{z.emoji}</span>
            <span>{z.label}</span>
          </button>
        ))}
      </div>
      <p id="zone-detail" class="zone-detail"></p>

      <!-- Mois -->
      <div class="month-tabs" role="tablist" aria-label="Mois">
        {MONTHS.map((m, i) => (
          <button class="month-tab" data-month={i + 1} type="button" role="tab">
            {m}
          </button>
        ))}
      </div>

      <p class="month-heading">
        🌱 Que semer en <strong id="month-label">…</strong> · climat{" "}
        <strong id="zone-label">…</strong>
      </p>
      <div class="legend">
        <span class="lg lg-abri">Semis sous abri</span>
        <span class="lg lg-terre">Semis pleine terre</span>
        <span class="lg lg-recolte">Récolte</span>
      </div>

      <div id="semis-grid" class="semis-grid"></div>
      <p class="disclaimer">
        * Dates indicatives selon le climat choisi — tenez compte des gelées
        tardives et de votre microclimat. Liens graines : affiliation Amazon.
      </p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq">
    <div class="kicker" data-reveal>Questions fréquentes</div>
    <h2 class="section-title" data-reveal data-delay="1">FAQ semis & climat</h2>
    <div class="faq-list" data-reveal data-delay="2">
      {faq.map((f) => (
        <details class="faq-item card">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <script is:inline>
    (function () {
      const data = JSON.parse(document.getElementById("semis-data").textContent);
      const { zones, cities, months, vegs } = data;
      const state = { zone: null, month: new Date().getMonth() + 1 };

      const zoneLabel = document.getElementById("zone-label");
      const zoneDetail = document.getElementById("zone-detail");
      const monthLabel = document.getElementById("month-label");
      const grid = document.getElementById("semis-grid");
      const geoStatus = document.getElementById("geo-status");
      const citySelect = document.getElementById("city-select");

      function shift(months, delta) {
        const s = months.map((m) => ((m + delta - 1 + 12) % 12) + 1);
        return [...new Set(s)].sort((a, b) => a - b);
      }

      function setZone(key) {
        state.zone = key;
        document.querySelectorAll(".zone-pill").forEach((el) =>
          el.classList.toggle("active", el.dataset.zone === key)
        );
        const z = zones[key];
        zoneLabel.textContent = z.label;
        zoneDetail.textContent = `${z.emoji} ${z.desc}`;
        geoStatus.textContent = `Climat sélectionné : ${z.label}`;
        render();
      }
      document.querySelectorAll(".zone-pill").forEach((btn) =>
        btn.addEventListener("click", () => setZone(btn.dataset.zone))
      );

      citySelect.addEventListener("change", () => {
        if (citySelect.value) {
          setZone(citySelect.value);
          const city = citySelect.options[citySelect.selectedIndex].dataset.city;
          geoStatus.textContent = `📍 ${city} — climat ${zones[citySelect.value].label}`;
        }
      });

      document.querySelectorAll(".month-tab").forEach((btn) =>
        btn.addEventListener("click", () => setMonth(parseInt(btn.dataset.month, 10)))
      );
      function setMonth(m) {
        state.month = m;
        document.querySelectorAll(".month-tab").forEach((el) =>
          el.classList.toggle("active", parseInt(el.dataset.month, 10) === m)
        );
        monthLabel.textContent = months[m - 1];
        render();
      }

      document.getElementById("geo-btn").addEventListener("click", () => {
        if (!navigator.geolocation) {
          geoStatus.textContent = "Géolocalisation non supportée — choisissez votre zone.";
          return;
        }
        geoStatus.textContent = "📍 Localisation en cours…";
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude: lat, longitude: lon } = pos.coords;
            let best = null, bestD = Infinity;
            for (const [name, clat, clon, z] of cities) {
              const d = Math.hypot(clat - lat, clon - lon);
              if (d < bestD) { bestD = d; best = [name, z]; }
            }
            setZone(best[1]);
            geoStatus.textContent = `📍 Détecté : ${best[0]} — climat ${zones[best[1]].label} (approx.)`;
          },
          () => {
            geoStatus.textContent = "Géolocalisation refusée ou indisponible — choisissez votre zone.";
          },
          { timeout: 6000, maximumAge: 600000 }
        );
      });

      function render() {
        const m = state.month;
        const z = state.zone || "bassin";
        const cards = [];

        for (const v of vegs) {
          const off = (v.off && v.off[z]) || 0;
          const abri = shift(v.abri, off);
          const terre = shift(v.terre, off);
          const recolte = shift(v.recolte, off);
          const inAbri = abri.includes(m);
          const inTerre = terre.includes(m);
          const inRecolte = recolte.includes(m);
          if (!inAbri && !inTerre && !inRecolte) continue;

          const aff = "https://www.amazon.fr/s?k=" + encodeURIComponent("graines de " + v.n.toLowerCase());
          const badges = [
            inAbri ? '<span class="b b-abri">Sous abri</span>' : "",
            inTerre ? '<span class="b b-terre">Pleine terre</span>' : "",
            inRecolte ? '<span class="b b-recolte">Récolte</span>' : "",
          ].join("");
          cards.push(`
            <div class="semis-card card">
              <div class="semis-head">
                <h3>${v.n}</h3>
                <span class="family">${v.f}</span>
              </div>
              <div class="badges">${badges}</div>
              <div class="meta">
                <span>📏 ${v.d} cm</span><span>↔️ ${v.e} cm</span><span>${v.su}</span>
              </div>
              <p class="companions">🌿 ${v.c}</p>
              <p class="tip">${v.tip}</p>
              <div class="semis-links">
                <a href="${aff}" target="_blank" rel="noopener sponsored nofollow" class="aff">Graines ↗</a>
                ${v.link ? `<a href="${v.link}" class="guide">Guide →</a>` : ""}
              </div>
            </div>
          `);
        }

        grid.innerHTML = cards.length
          ? cards.join("")
          : `<p class="empty">Rien à semer ni récolter en ${months[m - 1]} dans ce climat — profitez-en pour préparer le sol 🌱</p>`;
      }

      setMonth(state.month);
      setZone("bassin");
    })();
  </script>
</BaseLayout>

<style>
  .semis-hero { padding-bottom: 8px; }
  .semis-hero p { max-width: 560px; }

  /* ============ Panneau outil ============ */
  .semis-section { padding-top: 24px; }
  .tool-panel {
    background: var(--panel-strong);
    border: 1px solid var(--border);
    border-radius: 26px;
    padding: 30px;
    box-shadow: var(--shadow);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .geo-bar { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .geo-status { font-size: 13.5px; color: var(--muted); font-weight: 500; margin: 10px 0 16px; }
  .city-select {
    font-family: var(--font-body);
    font-size: 14px;
    padding: 11px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--paper);
    color: var(--text);
    max-width: 340px;
    cursor: pointer;
    flex: 1;
    min-width: 200px;
  }

  /* Zones : pills défilantes */
  .zone-pills {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 2px 2px 10px;
    scrollbar-width: thin;
    margin-bottom: 4px;
  }
  .zone-pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--paper);
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s;
  }
  .zone-pill:hover { border-color: var(--moss); color: var(--forest); }
  .zone-pill.active {
    background: var(--grad);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 6px 16px rgba(31, 77, 46, 0.3);
  }
  .zone-emoji { font-size: 16px; }
  .zone-detail { font-size: 13.5px; color: var(--muted); line-height: 1.55; margin: 0 0 20px; }

  /* Mois */
  .month-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 10px;
    margin-bottom: 14px;
    scrollbar-width: thin;
  }
  .month-tab {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    padding: 9px 18px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--paper);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
  }
  .month-tab:hover { color: var(--forest); border-color: var(--moss); }
  .month-tab.active {
    background: var(--grad);
    color: #fff;
    border-color: transparent;
    box-shadow: 0 6px 16px rgba(31, 77, 46, 0.3);
  }

  .month-heading { font-size: 16.5px; margin-bottom: 12px; color: var(--muted); }
  .month-heading strong { color: var(--forest-2); }

  .legend { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
  .lg { font-size: 12px; font-weight: 600; padding: 5px 13px; border-radius: 999px; }
  .lg-abri { background: rgba(217, 154, 61, 0.16); color: #9a6a1e; border: 1px solid rgba(217, 154, 61, 0.35); }
  .lg-terre { background: rgba(85, 128, 63, 0.14); color: var(--moss); border: 1px solid rgba(85, 128, 63, 0.35); }
  .lg-recolte { background: rgba(127, 163, 94, 0.14); color: #4c6b34; border: 1px solid rgba(127, 163, 94, 0.35); }

  /* Grille de légumes */
  .semis-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 16px;
  }
  .semis-card {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 18px 18px 16px;
  }
  .semis-head { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .semis-head h3 { font-size: 18px; }
  .family {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    background: rgba(47, 71, 43, 0.07);
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badges { display: flex; gap: 7px; flex-wrap: wrap; }
  .b { font-size: 12px; font-weight: 700; padding: 3px 11px; border-radius: 999px; }
  .b-abri { background: rgba(217, 154, 61, 0.16); color: #9a6a1e; }
  .b-terre { background: rgba(85, 128, 63, 0.14); color: var(--moss); }
  .b-recolte { background: rgba(127, 163, 94, 0.16); color: #4c6b34; }
  .meta { display: flex; gap: 12px; flex-wrap: wrap; font-size: 13px; color: var(--muted); }
  .companions { font-size: 13.5px; color: var(--text); margin: 0; }
  .tip { font-size: 13.5px; color: var(--muted); font-style: italic; margin: 0; }
  .semis-links { margin-top: auto; display: flex; gap: 10px; align-items: center; padding-top: 6px; }
  .aff {
    font-size: 13.5px;
    font-weight: 700;
    color: #fff;
    background: var(--grad);
    padding: 8px 18px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .aff:hover { transform: translateY(-2px); box-shadow: 0 8px 18px rgba(31, 77, 46, 0.35); color: #fff; }
  .guide { font-size: 13.5px; font-weight: 600; color: var(--forest); }
  .empty {
    grid-column: 1 / -1;
    text-align: center;
    color: var(--muted);
    background: var(--panel);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    padding: 30px;
  }
  .disclaimer { font-size: 12px; color: var(--muted); margin-top: 16px; }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: 12px; max-width: 760px; }
  .faq-item { padding: 16px 20px; }
  .faq-item summary {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--forest-2);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .faq-item summary::after { content: "＋"; color: var(--moss); font-size: 18px; transition: transform 0.2s; }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item p { margin: 12px 0 0; color: var(--muted); font-size: 14.5px; }

  /* ============ Mobile ============ */
  @media (max-width: 640px) {
    .semis-section { padding-top: 16px; }
    .tool-panel { padding: 20px 14px; border-radius: 20px; }
    .geo-bar { flex-direction: column; align-items: stretch; }
    .geo-bar .btn { width: 100%; justify-content: center; }
    .city-select { min-width: 0; width: 100%; max-width: none; }
    .zone-pills { margin: 0 -4px 4px; padding: 2px 4px 10px; }
    .zone-pill { padding: 10px 16px; font-size: 13.5px; }
    .zone-detail { font-size: 13px; margin-bottom: 16px; }
    .month-tabs { margin: 0 -4px 12px; padding: 2px 4px 10px; }
    .month-tab { padding: 9px 15px; font-size: 13.5px; }
    .month-heading { font-size: 15px; }
    .semis-grid { grid-template-columns: 1fr; gap: 12px; }
    .semis-card { padding: 16px 15px 14px; }
    .semis-head h3 { font-size: 17px; }
    .meta, .companions, .tip { font-size: 13px; }
    .semis-links { flex-wrap: wrap; }
    .faq-item summary { font-size: 16px; }
  }
</style>
